# ─── Core (required) ────────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml (host port 8053, database piercing_brand).
# Production/Coolify: point at the Postgres service by its INTERNAL hostname,
# e.g. postgresql://postgres:<password>@piercing-brand-db:5432/piercing_brand
# "localhost" is NEVER correct inside a container.
DATABASE_URL=postgresql://postgres:postgres@localhost:8053/piercing_brand

# Public origin of the site (used for emails, unsubscribe links, absolute URLs)
PUBLIC_ORIGIN=http://localhost:3000
# Origin better-auth signs/validates callbacks against. Must be the real
# public URL in production (https://your-domain.com).
BASE_URL=http://localhost:3000

# The app (Fastify + Vike) serves both API and frontend on this port.
PORT=3000

# Single Shop Mode
# Set to "true" to disable multi-vendor features and operate as a single shop
# When enabled:
# - Vendor registration is disabled
# - Only admins can access dashboard
# - Vendor-specific routes return 404
# - "Become a vendor" links are hidden
SINGLE_SHOP_MODE=true
VITE_SINGLE_SHOP_MODE=true

# ─── Store branding ─────────────────────────────────────────────────────────
# Single source of truth: shared/config/branding.ts. Everything below is
# optional — each value has a working default in that file. Set them here to
# rebrand without touching code. VITE_-prefixed vars reach both server and
# client bundles.
#
# Brand: Percé (see docs/CURRENT_PROJECT.md). Customer-facing name keeps
# the accent; the drawn wordmark is lowercase; operational identifiers use
# the ASCII form "perce". The misspelling with a trailing "e" is never used.
# VITE_STORE_NAME=Percé
# VITE_BRAND_WORDMARK=percé
# VITE_BRAND_LINE=Made to mix.
# Meta/social description. The default is the safer brand subheading; the
# preferred one below may be enabled once on-ear photography coverage of the
# live catalogue is verified.
# VITE_STORE_DESCRIPTION=Piercing jewellery, delivered across Egypt.
# VITE_STORE_DESCRIPTION=Piercing jewellery, photographed properly, delivered across Egypt.
# Egyptian pound. Catalogue prices are EGP amounts; nothing is FX-converted.
# VITE_CURRENCY=EGP
# Canonical storefront URL. Falls back to PUBLIC_ORIGIN/BASE_URL when unset.
# VITE_STORE_URL=https://your-domain.com

# Customer-facing support inbox. NO default — when this is unset the app
# omits the "contact us at ..." line from order emails and the storefront
# rather than printing an address nobody monitors. Set it before launch.
# VITE_SUPPORT_EMAIL=support@your-domain.com

# Social profiles. NO defaults — an unset profile is hidden everywhere
# (footer, /links page, emails, JSON-LD) instead of rendering a dead link.
# Percé launches with NEW accounts (intended convention: perce, e.g.
# @perce.eg). Set each one only once the account actually exists; do NOT
# point these at a previous brand's accounts.
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/perce.eg/
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/perce.eg
# VITE_SOCIAL_TIKTOK=https://www.tiktok.com/@perce.eg
# VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@perce.eg
# WhatsApp must be a full wa.me link for a number this store actually owns.
# VITE_SOCIAL_WHATSAPP=https://wa.me/20XXXXXXXXXX

# Store Owner ID (Single-Shop Mode)
# Default vendor/store owner UUID for database FK constraints
# Only needed if you want a custom store ID (optional, has secure default)
# STORE_OWNER_ID=00000000-0000-0000-0000-000000000001

# Email configuration
# Optional — leave commented out to disable outbound email entirely.
# The app logs a warning and skips sending when these are unset.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# Optional: visible "From" address/name, if different from SMTP_USER above
# (e.g. logging in via a transactional provider's SMTP relay/API key, but
# wanting mail to visibly come from cr@yourdomain.com). Falls back to
# SMTP_USER when unset.
# EMAIL_FROM_ADDRESS=cr@yourdomain.com
# EMAIL_FROM_NAME=Your Store Name
# Marketing-automation sending (abandoned cart, win-back, etc) is controlled
# live from the admin's Marketing Emails page (Automation Settings card) —
# an on/off switch plus a test-mode switch that restricts sending to one
# address — not an env var, so it can be toggled without a redeploy.

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Superadmin credentials (optional)
# Grants access to the hidden /dashboard/superadmin/sync page, which can
# export the ENTIRE database as a zip (for pulling a full prod snapshot down
# into dev), and — outside production only — import one to fully overwrite
# the local DB. Leave unset to skip bootstrapping this account entirely
# (recommended on any environment that doesn't need it). Requires
# pg_dump/pg_restore on PATH.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# Dev-only image fallback (optional)
# Uploaded files (products, logos, etc.) live on a persistent volume and are
# NOT copied down by the superadmin export above — only DB records are. When
# a synced DB references a file that isn't present in this environment's
# local uploads/ folder, set this to the live site's origin so the app
# fetches the real image from there instead of showing a broken image.
# Has no effect when NODE_ENV=production.
# PROD_ASSET_ORIGIN=https://your-live-domain.com

# Fincart integration
# Fincart shipping (opt-in — set FINCART_ENABLED=true to activate)
# FINCART_ENABLED=false
# FINCART_API_URL=https://api-v3.fincart.io
# FINCART_API_KEY=your-api-key
# FINCART_WEBHOOK_SECRET=your-webhook-secret
# FINCART_PICKUP_ID=your-pickup-id
# FINCART_MERCHANT_LOCATION=your-merchant-location

# Bosta shipping (opt-in — active when SYN_BOSTA_KEY is set)
# SYN_BOSTA_KEY=your-bosta-api-key
# BOSTA_WEBHOOK_SECRET=your-webhook-secret
# BOSTA_EGYPT_COUNTRY_ID=60e4482c7cb7d4bc4849c4d5
# Optional pickup override (otherwise fetched automatically from Bosta dashboard):
# Remove placeholder values like your-district-id — they are ignored.
# BOSTA_PICKUP_LOCATION_ID=

# ─── Auth secret (required) ─────────────────────────────────────────────────
# This is the secret better-auth uses to sign sessions (see
# backend/auth/auth.server.ts). Generate a NEW random value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse another brand's secret — doing so makes sessions cross-valid.
BETTER_AUTH_SECRET=generate-a-32-byte-random-hex-string
# Legacy alias, only read if BETTER_AUTH_SECRET is unset:
# SESSION_SECRET=

# Extra origins allowed to call the auth API (comma-separated). Set in
# production to your public domain(s) if they differ from BASE_URL.
# TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ─── Payment Gateways (Optional) ────────────────────────────────────────────
# Leave blank / remove to use COD-only mode.
# Add keys for any gateway you want to enable — they auto-activate.

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Paymob (Egypt) — leave blank to use COD-only mode
# PAYMOB_SECRET_KEY=egy_sk_live_...
# PAYMOB_PUBLIC_KEY=egy_pk_live_...
# PAYMOB_CARD_INTEGRATION_ID=your-card-integration-id
# PAYMOB_WALLET_INTEGRATION_ID=your-wallet-integration-id
# PAYMOB_HMAC_SECRET=your-hmac-secret
# PAYMOB_BASE_URL=https://accept.paymob.com
