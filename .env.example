# ─── Core (required) ────────────────────────────────────────────────────────
# Local dev: matches docker-compose.yml (host port 8053, database piercing_brand).
# Production/Coolify: point at the Postgres service by its INTERNAL hostname,
# e.g. postgresql://postgres:<password>@piercing-brand-db:5432/piercing_brand
# "localhost" is NEVER correct inside a container.
DATABASE_URL=postgresql://postgres:postgres@localhost:8053/piercing_brand

# Public origin of the site (used for emails, unsubscribe links, absolute URLs)
PUBLIC_ORIGIN=http://localhost:3000
# Origin better-auth signs/validates callbacks against. Must be the real
# public URL in production (https://your-domain.com).
BASE_URL=http://localhost:3000

# The app (Fastify + Vike) serves both API and frontend on this port.
PORT=3000

# Single Shop Mode
# Set to "true" to disable multi-vendor features and operate as a single shop
# When enabled:
# - Vendor registration is disabled
# - Only admins can access dashboard
# - Vendor-specific routes return 404
# - "Become a vendor" links are hidden
SINGLE_SHOP_MODE=true
VITE_SINGLE_SHOP_MODE=true

# ─── Store branding ─────────────────────────────────────────────────────────
# Single source of truth: shared/config/branding.ts. Everything below is
# optional — each value has a working default in that file. Set them here to
# rebrand without touching code. VITE_-prefixed vars reach both server and
# client bundles.
#
# Brand: Percé (see docs/CURRENT_PROJECT.md). Customer-facing name keeps
# the accent; the drawn wordmark is lowercase; operational identifiers use
# the ASCII form "perce". The misspelling with a trailing "e" is never used.
# VITE_STORE_NAME=Percé
# VITE_BRAND_WORDMARK=percé
# VITE_BRAND_LINE=Made to mix.
# Meta/social description. The default is the safer brand subheading; the
# preferred one below may be enabled once on-ear photography coverage of the
# live catalogue is verified.
# VITE_STORE_DESCRIPTION=Piercing jewellery, delivered across Egypt.
# VITE_STORE_DESCRIPTION=Piercing jewellery, photographed properly, delivered across Egypt.
# Egyptian pound. Catalogue prices are EGP amounts; nothing is FX-converted.
# VITE_CURRENCY=EGP
# Canonical storefront URL. Falls back to PUBLIC_ORIGIN/BASE_URL, then to the
# production domain https://perce-eg.com.
# VITE_STORE_URL=https://perce-eg.com

# Customer-facing support inbox. Defaults to the owner-confirmed Percé inbox
# (piercingperce@gmail.com); it is also the Reply-To of every email.
# VITE_SUPPORT_EMAIL=piercingperce@gmail.com
# Customer-service WhatsApp in E.164 form. Defaults to +201035790911.
# VITE_SUPPORT_WHATSAPP=+201035790911

# Social profiles. NO defaults — an unset profile is hidden everywhere
# (footer, /links page, emails, JSON-LD) instead of rendering a dead link.
# Percé launches with NEW accounts (intended convention: perce, e.g.
# @perce.eg). Set each one only once the account actually exists; do NOT
# point these at a previous brand's accounts.
# VITE_SOCIAL_INSTAGRAM=https://www.instagram.com/perce.eg/
# VITE_SOCIAL_FACEBOOK=https://www.facebook.com/perce.eg
# VITE_SOCIAL_TIKTOK=https://www.tiktok.com/@perce.eg
# VITE_SOCIAL_YOUTUBE=https://www.youtube.com/@perce.eg
# WhatsApp must be a full wa.me link for a number this store actually owns.
# VITE_SOCIAL_WHATSAPP=https://wa.me/20XXXXXXXXXX

# Store Owner ID (Single-Shop Mode)
# Default vendor/store owner UUID for database FK constraints
# Only needed if you want a custom store ID (optional, has secure default)
# STORE_OWNER_ID=00000000-0000-0000-0000-000000000001

# Email configuration
# Optional — leave commented out to disable outbound email entirely.
# The app logs a warning and skips sending when these are unset.
# SMTP_HOST=smtp.gmail.com
# Port decides the TLS mode: 465 = implicit TLS, 587 (or any other) =
# STARTTLS, which is then required. SMTP_SECURE=true|false overrides that.
# SMTP_PORT=465
# SMTP_USER=your-email@example.com
# SMTP_PASSWORD=your-app-password
# SMTP_SECURE=
# Optional: visible "From" address/name, if different from SMTP_USER above
# (e.g. logging in via a transactional provider's SMTP relay/API key, but
# wanting mail to visibly come from orders@perce-eg.com). The address falls
# back to SMTP_USER; the name falls back to the store name.
# EMAIL_FROM_ADDRESS=orders@perce-eg.com
# EMAIL_FROM_NAME=Percé
# Reply-To for every email. Defaults to VITE_SUPPORT_EMAIL.
# EMAIL_REPLY_TO=piercingperce@gmail.com
# Who receives the "New order" store notification. Runtime variable, read for
# every order. Separate addresses with commas, semicolons, spaces or new lines.
# With at least one valid address ONLY those are notified (admin users are not
# looked up). Unset → every user with role "admin" (the old behaviour); set but
# with no valid address → the same, plus a warning. Kept separate from
# ADMIN_EMAIL, which is a dashboard login, not necessarily an inbox. Start-up
# logs "[OrderEmails] New-order notifications → …" with addresses masked.
# ORDER_NOTIFICATION_EMAILS=owner@example.com
# Order confirmations and new-order notifications go through the email queue
# and are sent even while marketing automations are switched off.
# Marketing-automation sending (abandoned cart, win-back, etc) is controlled
# live from the admin's Marketing Emails page (Automation Settings card) —
# an on/off switch plus a test-mode switch that restricts sending to one
# address — not an env var, so it can be toggled without a redeploy.

# Admin credentials
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=changeme

# Superadmin credentials (optional)
# Grants access to the hidden /dashboard/superadmin/sync page, which can
# export the ENTIRE database as a zip (for pulling a full prod snapshot down
# into dev), and — outside production only — import one to fully overwrite
# the local DB. Leave unset to skip bootstrapping this account entirely
# (recommended on any environment that doesn't need it). Requires
# pg_dump/pg_restore on PATH.
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=

# Dev-only image fallback (optional)
# Uploaded files (products, logos, etc.) live on a persistent volume and are
# NOT copied down by the superadmin export above — only DB records are. When
# a synced DB references a file that isn't present in this environment's
# local uploads/ folder, set this to the live site's origin so the app
# fetches the real image from there instead of showing a broken image.
# Has no effect when NODE_ENV=production.
# PROD_ASSET_ORIGIN=https://your-live-domain.com

# Fincart integration
# Fincart shipping (opt-in — set FINCART_ENABLED=true to activate)
# FINCART_ENABLED=false
# FINCART_API_URL=https://api-v3.fincart.io
# FINCART_API_KEY=your-api-key
# FINCART_WEBHOOK_SECRET=your-webhook-secret
# FINCART_PICKUP_ID=your-pickup-id
# FINCART_MERCHANT_LOCATION=your-merchant-location

# Bosta shipping (opt-in — active when SYN_BOSTA_KEY is set)
# SYN_BOSTA_KEY=your-bosta-api-key
# BOSTA_WEBHOOK_SECRET=your-webhook-secret
# BOSTA_EGYPT_COUNTRY_ID=60e4482c7cb7d4bc4849c4d5
# Optional pickup override (otherwise fetched automatically from Bosta dashboard):
# Remove placeholder values like your-district-id — they are ignored.
# BOSTA_PICKUP_LOCATION_ID=

# ABS courier tracking — READ-ONLY poller (see docs/ABS_TRACKING.md).
# ABS_TRACKING_MODE: off (default; also any unknown value) = nothing starts |
# shadow = poll ABS, link shipments to orders, RECORD would-be decisions in the
# abs_* tables only (no order/stock change) | live = not in this build (runs
# shadow + a boot warning). Needs migration 0070, else stays off.
# ABS_TRACKING_MODE=off
# ABS_API_BASE_URL: ABS Client API base, https:// only, no default (not yet confirmed by ABS).
# ABS_API_BASE_URL=
# ABS_API_KEY: Read-scope key (Shipments/Tracking/Wallet: Read). Secret — env only, never logged.
# ABS_API_KEY=
# ABS_POLL_INTERVAL_MS: tick interval (default 600000 = 10 min; floor 300000).
# ABS_POLL_INTERVAL_MS=600000
# ABS_POLL_OVERLAP_MS: each window re-reads this far before the watermark (default 1800000).
# ABS_POLL_OVERLAP_MS=1800000
# ABS_BACKFILL_FROM: first-run start, YYYY-MM-DD = Cairo midnight (default 2026-11-01).
# ABS_BACKFILL_FROM=2026-11-01
# ABS_MATCH_WINDOW_DAYS: order created_at window before the ABS shipment date (default 10).
# ABS_MATCH_WINDOW_DAYS=10
# ABS_COD_TOLERANCE_EGP: allowed |order total − ABS COD| (default 1).
# ABS_COD_TOLERANCE_EGP=1
# ABS_ONLY_SINCE: ABS is the only courier for orders placed on/after this Cairo date; older orders never raise "no ABS shipment" (default 2026-11-18).
# ABS_ONLY_SINCE=2026-11-18
# ABS_MISSING_AWB_ALERT_DAYS: list a processing/shipped order with no ABS shipment after this many days (default 2).
# ABS_MISSING_AWB_ALERT_DAYS=2
# ABS_REVERSE_WINDOW_DAYS: candidate window for REVERSE/EXCHANGE shipments, suggestions only (default 45).
# ABS_REVERSE_WINDOW_DAYS=45

# ─── Auth secret (required) ─────────────────────────────────────────────────
# This is the secret better-auth uses to sign sessions (see
# backend/auth/auth.server.ts). Generate a NEW random value per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse another brand's secret — doing so makes sessions cross-valid.
BETTER_AUTH_SECRET=generate-a-32-byte-random-hex-string
# Legacy alias, only read if BETTER_AUTH_SECRET is unset:
# SESSION_SECRET=

# Extra origins allowed to call the auth API (comma-separated). Set in
# production to your public domain(s) if they differ from BASE_URL.
# TRUSTED_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ─── Payment Gateways (Optional) ────────────────────────────────────────────
# Leave blank / remove to use COD-only mode.
# Add keys for any gateway you want to enable — they auto-activate.

# Stripe
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# VITE_STRIPE_PUBLIC_KEY=pk_test_...

# Paymob (Egypt) — leave blank to use COD-only mode
# PAYMOB_SECRET_KEY=egy_sk_live_...
# PAYMOB_PUBLIC_KEY=egy_pk_live_...
# PAYMOB_CARD_INTEGRATION_ID=your-card-integration-id
# PAYMOB_WALLET_INTEGRATION_ID=your-wallet-integration-id
# PAYMOB_HMAC_SECRET=your-hmac-secret
# PAYMOB_BASE_URL=https://accept.paymob.com

# ─── ERP integration (optional) ─────────────────────────────────────────────
# Shared secret the ERP uses to PULL orders and the catalogue from the
# read-only export API at /api/erp/v1 (backend/erp-sync). Unset, or shorter
# than 32 characters = the API is not registered at all (every path 404s).
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# The same value goes into the ERP as STOREFRONT_SYNC_TOKEN_PERCE.
# ERP_SYNC_TOKEN=

# --- Tracking (server env; neither is a secret) -----------------------------
# TRACKING_EXCLUDE_INTERNAL: no GA4 / Meta / pixels / beacon on /dashboard* and
# /admin*. DEFAULT ON when unset; only false/0/no/off turns it off.
# TRACKING_EXCLUDE_INTERNAL=true
# GA4_MP_MODE: what the server sends to GA4 via the Measurement Protocol.
#   off (default) - nothing; the browser gtag owns every GA4 event (no doubles)
#   legacy_all    - mirror every event again (DOUBLE COUNTS; rollback only)
# GA4_MP_MODE=off
# GA4_PURCHASE_OWNER: who sends the GA4 `purchase` event. browser (default) =
# gtag on /order-confirmation, as before; shadow = browser still sends, the
# server records/prepares candidates and sends nothing; server = the server
# sends it from the verified order via the outbox and the browser skips only
# `purchase`. Needs migration 0069 (else stays browser) and the GA4 API secret
# in the GA4 pixel row. See backend/pixel-tracking/ga4-purchase/README.md.
# GA4_PURCHASE_OWNER=browser
# META_ADVANCED_MATCHING: Meta match quality — pixel init with pre-hashed
# external_id (+ signed-in shopper em/ph/fn/ln), _fbc from ?fbclid=, short wait
# for _fbp before the first beacon; CAPI adds hashed external_id, signed-in
# account fields and, for a Purchase, the verified order's hashed fields.
# DEFAULT ON when unset; only false/0/no/off turns it off (previous user_data).
# META_ADVANCED_MATCHING=true
# META_CAPI_SKIP_ENGAGEMENT: scroll_depth and time_on_page are not relayed to
# the Meta Conversions API (the browser pixel and tracking_event keep them).
# DEFAULT ON when unset; only false/0/no/off relays them again.
# META_CAPI_SKIP_ENGAGEMENT=true
# META_FBC_FALLBACK: the browser keeps the landing ?fbclid= in localStorage and
# each /api/track event carries it as fbcHint; the Conversions API copy uses it
# only when the request has no _fbc cookie (validated, never stored, no DB
# lookup). DEFAULT ON when unset; only false/0/no/off turns it off.
# META_FBC_FALLBACK=true
# GA4_CLIENT_ID_CONTINUITY: the SSR gtag snippet keeps the _ga client id in
# localStorage and passes it as client_id only when the _ga cookie is missing
# (never invented, never overrides a valid _ga). DEFAULT ON when unset; only
# false/0/no/off restores the previous snippet exactly.
# GA4_CLIENT_ID_CONTINUITY=true
